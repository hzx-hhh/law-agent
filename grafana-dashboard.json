    {"type":"stat","title":"5xx 数量","targets":[{"expr":"sum(increase(legal_agent_requests_total{status=~\"5..\"}[1h]))"}],"gridPos":{"h":6,"w":8,"x":0,"y":8}},
    {"type":"stat","title":"降级分析数量","targets":[{"expr":"sum(increase(legal_agent_requests_total{status=\"200\"}[1h]))"}],"gridPos":{"h":6,"w":8,"x":8,"y":8}}
